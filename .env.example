# URL gốc của Jira (có thể kèm context path, VD: https://jira.example.com/jira)
JIRA_BASE_URL=https://jira.xxx.com.vn
# Danh sách host được phép gọi tới (phân cách dấu phẩy). Mặc định = host của JIRA_BASE_URL
JIRA_ALLOWED_HOSTS=
# Server
API_PORT=3001
HOST=127.0.0.1
# Session hết hạn sau N phút không hoạt động
SESSION_IDLE_MINUTES=480
# Đặt true nếu truy cập ứng dụng qua HTTPS
COOKIE_SECURE=false
# Thư mục lưu settings.json (mặc định ./data)
DATA_DIR=
# Bật session lưu trong cookie mã hoá (BẮT BUỘC khi deploy serverless như Vercel), >= 32 ký tự.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Settings ban đầu dạng JSON (dùng trên Vercel vì file settings không lưu bền được)
SETTINGS_JSON=
